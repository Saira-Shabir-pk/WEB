<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'EB Garamond', Georgia, serif; background: #f5f5f5; }
    .login-container {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 20px;
    }
    .login-box {
      background: #fff;
      padding: 40px;
      border: 1px solid #e0e0e0;
      width: 100%;
      max-width: 400px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }
    .login-box h1 {
      font-size: 28px;
      font-weight: 400;
      letter-spacing: .1em;
      margin-bottom: 8px;
      text-align: center;
    }
    .login-box p {
      text-align: center;
      font-size: 13px;
      color: #777;
      margin-bottom: 30px;
    }
    .form-group {
      margin-bottom: 20px;
    }
    .form-group label {
      display: block;
      font-size: 12px;
      letter-spacing: .08em;
      margin-bottom: 6px;
      font-weight: 500;
    }
    .form-group input {
      width: 100%;
      padding: 10px;
      border: 1px solid #ccc;
      font-size: 14px;
      font-family: Arial, sans-serif;
      outline: none;
      transition: border-color .2s;
    }
    .form-group input:focus { border-color: #041e3a; }
    .error {
      background: #fee;
      color: #c33;
      padding: 10px;
      border-radius: 4px;
      font-size: 12px;
      margin-bottom: 16px;
      text-align: center;
    }
    .btn {
      width: 100%;
      height: 40px;
      background: #041e3a;
      color: #fff;
      border: 1px solid #041e3a;
      font-size: 12px;
      letter-spacing: .13em;
      cursor: pointer;
      transition: background .2s;
      font-family: Arial, sans-serif;
    }
    .btn:hover { background: #333; }
  </style>
</head>
<body>
  <div class="login-container">
    <div class="login-box">
      <h1>ADMIN</h1>
      <p>Restricted Access</p>

      <% if (typeof error !== 'undefined') { %>
        <div class="error"><%= error %></div>
      <% } %>

      <form method="POST" action="/admin/login">
        <div class="form-group">
          <label>Password</label>
          <input type="password" name="password" required />
        </div>
        <button type="submit" class="btn">LOGIN</button>
      </form>
    </div>
  </div>
</body>
</html>