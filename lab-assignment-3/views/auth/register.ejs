<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: 'EB Garamond', Georgia, serif;
      background: #f7f5f2;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px 20px;
    }

    .auth-card {
      background: #fff;
      border: 1px solid #ddd;
      width: 100%;
      max-width: 420px;
      padding: 0;
      box-shadow: 0 2px 20px rgba(0,0,0,.06);
    }

    .auth-card__header {
      background: #041e3a;
      color: #fff;
      padding: 32px 40px 28px;
      text-align: center;
    }

    .auth-card__logo {
      font-size: 11px;
      letter-spacing: .22em;
      text-transform: uppercase;
      opacity: .7;
      margin-bottom: 10px;
    }

    .auth-card__title {
      font-size: 26px;
      font-weight: 400;
      letter-spacing: .08em;
    }

    .auth-card__body {
      padding: 32px 40px 36px;
    }

    .flash {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 12px 16px;
      font-family: Arial, sans-serif;
      font-size: 12px;
      letter-spacing: .03em;
      border-left: 3px solid #c33;
      background: #fff5f5;
      color: #7a1010;
      margin-bottom: 22px;
    }

    .form-group {
      margin-bottom: 18px;
    }

    .form-group label {
      display: block;
      font-size: 11px;
      letter-spacing: .1em;
      text-transform: uppercase;
      margin-bottom: 6px;
      color: #555;
    }

    .form-group input {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid #ccc;
      font-size: 15px;
      font-family: 'EB Garamond', Georgia, serif;
      color: #222;
      outline: none;
      transition: border-color .2s;
      background: #fafafa;
    }

    .form-group input:focus {
      border-color: #041e3a;
      background: #fff;
    }

    .btn-primary {
      width: 100%;
      height: 44px;
      background: #041e3a;
      color: #fff;
      border: none;
      font-family: Arial, sans-serif;
      font-size: 12px;
      letter-spacing: .14em;
      text-transform: uppercase;
      cursor: pointer;
      margin-top: 8px;
      transition: background .2s;
    }
    .btn-primary:hover { background: #0a3060; }

    .auth-switch {
      text-align: center;
      margin-top: 22px;
      font-size: 13px;
      color: #666;
    }
    .auth-switch a {
      color: #041e3a;
      font-weight: 500;
    }

    .password-hint {
      font-size: 11px;
      color: #999;
      font-family: Arial, sans-serif;
      margin-top: 4px;
      letter-spacing: .02em;
    }
  </style>
</head>
<body>

  <div class="auth-card">
    <div class="auth-card__header">
      <div class="auth-card__logo">Ralph Lauren</div>
      <h1 class="auth-card__title">Create Account</h1>
    </div>

    <div class="auth-card__body">

      <% if (flashError && flashError.length > 0) { %>
        <div class="flash"><span><%= flashError[0] %></span></div>
      <% } %>
      <% if (flashSuccess && flashSuccess.length > 0) { %>
        <div class="flash" style="border-color:#2d8a4e;background:#f0faf4;color:#1e5c34;"><span><%= flashSuccess[0] %></span></div>
      <% } %>

      <form method="POST" action="/auth/register">
        <div class="form-group">
          <label for="name">Full Name</label>
          <input type="text" id="name" name="name" required autocomplete="name" placeholder="e.g. Ali Hassan" />
        </div>

        <div class="form-group">
          <label for="email">Email Address</label>
          <input type="email" id="email" name="email" required autocomplete="email" placeholder="you@example.com" />
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" required autocomplete="new-password" placeholder="••••••••" />
          <p class="password-hint">Minimum 6 characters</p>
        </div>

        <div class="form-group">
          <label for="confirmPassword">Confirm Password</label>
          <input type="password" id="confirmPassword" name="confirmPassword" required autocomplete="new-password" placeholder="••••••••" />
        </div>

        <button type="submit" class="btn-primary">Create Account</button>
      </form>

      <p class="auth-switch">
        Already have an account? <a href="/auth/login">Sign in</a>
      </p>

    </div>
  </div>

</body>
</html>
