<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>

  <!-- Font Awesome -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@400;500&display=swap" rel="stylesheet" />
  <!-- Main stylesheet -->
  <link rel="stylesheet" href="/css/style.css" />
  
  <style>
    /* Flash messages styling */
    .flash-messages { margin: 0; }
    .alert { padding: 12px 20px; margin: 0; font-size: 14px; border-radius: 0; }
    .alert-success { background: #d4edda; color: #155724; border-bottom: 1px solid #c3e6cb; }
    .alert-error { background: #f8d7da; color: #721c24; border-bottom: 1px solid #f5c6cb; }
  </style>
</head>
<body>

<!-- Flash Messages -->
<div class="flash-messages">
  <% if (messages && messages.success && messages.success.length > 0) { %>
    <% messages.success.forEach(msg => { %>
      <div class="alert alert-success"><%= msg %></div>
    <% }) %>
  <% } %>
  
  <% if (messages && messages.error && messages.error.length > 0) { %>
    <% messages.error.forEach(msg => { %>
      <div class="alert alert-error"><%= msg %></div>
    <% }) %>
  <% } %>
</div>